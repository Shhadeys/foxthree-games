{
    "name": "foxthree-games-worker",
    "main": "worker.js",
    "compatibility_date": "2026-09-16",
    "routes": [
        {
            "pattern": "study.studyingtools.org",
            "custom_domain": true
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "foxthree-games"
        }
    ]
}
